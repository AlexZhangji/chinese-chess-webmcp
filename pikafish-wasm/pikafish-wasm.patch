+// WebAssembly entry point.
+//
+// A browser has no blocking stdin, so UCIEngine::loop() cannot be used: it
+// would park the only thread the page has and freeze the tab. Instead main()
+// just builds the engine and returns, leaving the module resident
+// (-sEXIT_RUNTIME=0), and the JS side pushes commands in one at a time through
+// pikafish_command() below.
+//
+// This is safe precisely because UCI is already asynchronous in this codebase:
+// "go" hands the position to the thread pool and returns, and results come back
+// through the on_update_full / on_bestmove callbacks, which write to stdout ->
+// Module.print -> the JS message listeners. So no call made here ever blocks.
+
+namespace {
+// Deliberately leaked: the module outlives main(), and tearing the engine down
+// at static-destruction time would race with search threads that are still
+// running.
+UCIEngine* g_uci = nullptr;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void pikafish_command(const char* cmd);  // silence
+                                                                        // -Wmissing-prototypes
+
+extern "C" EMSCRIPTEN_KEEPALIVE void pikafish_command(const char* cmd) {
+    if (g_uci && cmd)
+        g_uci->execute(std::string(cmd));
+}
+
+int main(int argc, char* argv[]) {
+    std::cout << engine_info() << std::endl;
+
+    Attacks::init();
+    Position::init();
+
+    auto cli = CommandLine(argc, argv);
+    g_uci    = new UCIEngine(std::move(cli));
+
+    Tune::init(g_uci->engine_options());
+
+    // No loop() here -- see comment above.
+    return 0;
+}
+
+#else
